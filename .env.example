# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service role) key. Server only: used for the public lead form, the
# health check and the demo seed script. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app (used in email links and the shareable form link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string, at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=

# Shared demo account used by the "Try the live demo" button
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
